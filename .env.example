# Copy to .env next to docker-compose.yml. It stays on the host and out of git.

# The public hostname this runs at. nginx-proxy routes it to the container and
# gets its certificate, and the agent builds its webhook URLs from it.
PUBLIC_HOST=pumpkin.example.com

# SignalWire. On startup the agent creates (or corrects) its resource in this
# space and mints the tokens the pumpkin page calls with. The API token
# needs the Voice scope.
SIGNALWIRE_SPACE=yourspace.signalwire.com
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=

# Optional: a password the browser asks for before showing the pumpkin page.
# Recommended, since the page can start a (billed) call to the pumpkin.
EYES_PASSWORD=

# Optional: 1 attaches the quality-control monitor (qc_monitor.py), a second AI
# that listens to the call, never speaks, and grades the pumpkin's replies and
# tool use at /eyes/qc.html. It's billed per minute while attached: the whole
# evening for this prop.
QC_MONITOR=

# Optional: the local time zone, so the live log (/eyes-live) starts a new day at
# your midnight, not UTC's. A POSIX TZ string works without extra packages,
# e.g. EST5EDT,M3.2.0,M11.1.0 or PST8PDT,M3.2.0,M11.1.0. Empty is UTC.
TZ=

# Optional: pick the mic and camera by part of their name. Empty uses Chrome's defaults.
PUMPKIN_MIC_LABEL=
PUMPKIN_CAMERA_LABEL=

# Optional: the basic auth SignalWire uses to fetch the agent. Derived from the
# API token when unset; set these only to choose your own.
# SWML_BASIC_AUTH_USER=
# SWML_BASIC_AUTH_PASSWORD=
